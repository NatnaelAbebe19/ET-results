TELEGRAM_BOT_TOKEN=your_bot_token_here
CHECK_INTERVAL_SECONDS=30
BASE_URL=https://your-app.onrender.com
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Quiet hours (Pause automated checking between 6:00 PM and 7:00 AM East Africa Time)
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=18
QUIET_HOURS_END=7
BOT_TIMEZONE=Africa/Addis_Ababa

# Discord Interactive Bot (optional — runs alongside Telegram with /filter buttons & commands)
# Get token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Optional: Discord Webhook (one-way channel feed, if you also want webhook alerts)
DISCORD_WEBHOOK_URL=
# Role filter for Discord webhook notifications: all | pilot | cabin | amt | aviation
DISCORD_ROLE_FILTER=all
